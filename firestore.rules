rules_version = '2';

// Firestore security rules for Kannada Kids (project kannadakids-fd92d).
// Published by the "Deploy backend" GitHub action (or: firebase deploy --only firestore:rules).
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // An admin is anyone with a document at admins/{their e-mail, lower case}.
    // The e-mail must be verified (Google / Apple sign-in), so nobody can claim an admin's
    // address with an unverified e-mail/password account.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }

    // The owner (role "owner") can give and take away admin rights.
    function isAppOwner() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(myEmail())).data.role == 'owner';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // App settings anyone can read (e.g. config/app.videoBase = where videos are played from).
    // Only admins can change them.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One document per family: their plan, renewal date, payments.
    // The plan, status, dates and payments are written ONLY by the verifyPurchases Cloud Function
    // (functions/index.js) after Google Play / the App Store confirm the purchase. The function uses
    // the Admin SDK, which these rules don't limit. Families can only read their own record.
    // Admins can only give or take away free time (bonusUntil / bonusNote / bonusBy).
    function onlyBonusFields(keys) {
      return keys.hasOnly(['bonusUntil', 'bonusNote', 'bonusBy']);
    }
    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() && onlyBonusFields(request.resource.data.keys());
      allow update: if isAdmin() && onlyBonusFields(request.resource.data.diff(resource.data).affectedKeys());
      // Admins, or the family itself when they delete their account
      allow delete: if isAdmin() || isOwner(uid);
    }

    // Purchase proofs and "which account owns this App Store subscription": server only.
    match /purchaseRecords/{uid} {
      allow read, write: if false;
    }
    match /purchaseClaims/{id} {
      allow read, write: if false;
    }

    // Admin list. The owner's own record is created by the app the first time
    // ramesh.katru01@gmail.com signs in; after that only the owner can add or remove admins.
    match /admins/{email} {
      allow read: if isAdmin() || (request.auth != null && myEmail() == email);
      allow create: if (request.auth != null
                        && email == 'ramesh.katru01@gmail.com'
                        && myEmail() == email
                        && request.auth.token.email_verified == true
                        && request.resource.data.role == 'owner')
                    || (isAppOwner() && request.resource.data.role == 'admin');
      allow update: if isAppOwner() && request.resource.data.role == 'admin' && email != myEmail();
      allow delete: if isAppOwner() && email != myEmail();
    }
  }
}
