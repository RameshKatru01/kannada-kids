rules_version = '2';

// Firestore security rules for Kannada Kids (project kannadakids-fd92d).
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // An admin is anyone with a document at admins/{their e-mail, lower case}.
    // The e-mail must be verified (Google / Apple sign-in), so nobody can claim an admin's
    // address with an unverified e-mail/password account.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }

    // The owner (role "owner") can give and take away admin rights.
    function isAppOwner() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(myEmail())).data.role == 'owner';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // App settings anyone can read (e.g. config/app.videoBase = where videos are played from).
    // Only admins can change them.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One document per family: their plan, renewal date, payments.
    // Families can write their own record, but only an admin can give free time (bonusUntil).
    match /subscriptions/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // The free trial's start (trialStart) can't be set in the future, and once set can only move earlier.
      allow create: if isOwner(uid) && !('bonusUntil' in request.resource.data)
        && request.resource.data.get('trialStart', 0) <= request.time.toMillis() + 600000;
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.get('bonusUntil', 0) == resource.data.get('bonusUntil', 0)
            && request.resource.data.get('bonusNote', '') == resource.data.get('bonusNote', '')
            && request.resource.data.get('trialStart', 0) <= request.time.toMillis() + 600000
            && (!('trialStart' in resource.data) || request.resource.data.get('trialStart', 0) <= resource.data.trialStart));
      // Admins, or the family itself when they delete their account
      allow delete: if isAdmin() || isOwner(uid);
    }

    // Admin list. The owner's own record is created by the app the first time
    // ramesh.katru01@gmail.com signs in; after that only the owner can add or remove admins.
    match /admins/{email} {
      allow read: if isAdmin() || (request.auth != null && myEmail() == email);
      allow create: if (request.auth != null
                        && email == 'ramesh.katru01@gmail.com'
                        && myEmail() == email
                        && request.auth.token.email_verified == true
                        && request.resource.data.role == 'owner')
                    || (isAppOwner() && request.resource.data.role == 'admin');
      allow update: if isAppOwner() && request.resource.data.role == 'admin' && email != myEmail();
      allow delete: if isAppOwner() && email != myEmail();
    }
  }
}
