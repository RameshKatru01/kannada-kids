// ---- Fill these in before building for a real iPhone / the App Store ----

// Your Apple Developer Team ID (Xcode > Settings > Accounts), e.g. ABCDE12345
TEAM_ID=

// The iOS bundle identifier (must be unique in the App Store)
PRODUCT_BUNDLE_IDENTIFIER=com.aistudio.kannadakids.ios
PRODUCT_NAME=KannadaKids
MARKETING_VERSION=1.1
CURRENT_PROJECT_VERSION=1

// Firebase / Google Sign-In settings (project kannadakids-fd92d) are written straight into
// iosApp/Info.plist (GIDClientID, GIDServerClientID, FIREBASE_API_KEY, URL scheme).
// They belong to the bundle ID above: if you change it, add a new iOS app in Firebase.
